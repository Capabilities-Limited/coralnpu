# Dependency pins, committed on purpose (see Bender.yml). These override the version ranges that
# CVFPU's manifest asks for, so Bender checks out the revisions the Bazel build uses.
overrides:
  common_cells:     {git: "https://github.com/pulp-platform/common_cells.git",     rev: 6aeee85d0a34fedc06c14f04fd6363c9f7b4eeea}
  fpu_div_sqrt_mvp: {git: "https://github.com/pulp-platform/fpu_div_sqrt_mvp.git", rev: 86e1f558b3c95e91577c41b2fc452c86b04e85ac}
